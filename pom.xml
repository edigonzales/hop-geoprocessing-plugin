<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>ch.so.agi</groupId>
  <artifactId>hop-geoprocessing-plugin-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Apache Hop Geoprocessing Plugin</name>
  <description>Apache Hop plugin suite for geoprocessing transforms.</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>hop-geoprocessing-core</module>
    <module>hop-transform-geometry-ops</module>
    <module>hop-transform-coverage-ops</module>
    <module>hop-transform-spatial-predicate</module>
    <module>hop-transform-layer-overlay</module>
    <module>hop-transform-layer-aggregate</module>
    <module>hop-transform-geometry-converter</module>
    <module>hop-transform-geometry-reproject</module>
    <module>assemblies</module>
  </modules>

  <properties>
    <hop.geometry.type.version>0.2.0-SNAPSHOT</hop.geometry.type.version>
    <jts.version>1.20.0</jts.version>
    <geotools.version>35.1</geotools.version>
    <indriya.version>2.2</indriya.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Same Jackson 3 streaming runtime supplied by Geometry Type / GeoTools 35.1. -->
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>3.2.0</version>
      </dependency>
      <dependency>
        <groupId>org.geotools</groupId>
        <artifactId>gt-bom</artifactId>
        <version>${geotools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.geotools</groupId>
        <artifactId>gt-platform-dependencies</artifactId>
        <version>${geotools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>tech.units</groupId>
        <artifactId>indriya</artifactId>
        <version>${indriya.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Bootstrap the published parent before its repositories are inherited. -->
  <repositories>
    <repository>
      <id>osgeo</id>
      <url>https://repo.osgeo.org/repository/release/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>sogeo-snapshots</id>
      <url>https://jars.interlis.guru/snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
</project>
