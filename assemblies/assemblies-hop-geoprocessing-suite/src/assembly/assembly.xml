<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
  <id>plugin</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>

  <dependencySets>
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>false</useTransitiveDependencies>
      <outputDirectory>plugins/transforms/hop-geoprocessing</outputDirectory>
      <scope>runtime</scope>
      <unpack>false</unpack>
      <includes>
        <include>ch.so.agi:hop-transform-geometry-ops</include>
        <include>ch.so.agi:hop-transform-coverage-ops</include>
        <include>ch.so.agi:hop-transform-spatial-predicate</include>
        <include>ch.so.agi:hop-transform-layer-overlay</include>
        <include>ch.so.agi:hop-transform-layer-aggregate</include>
      </includes>
    </dependencySet>

    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>true</useTransitiveDependencies>
      <outputDirectory>plugins/transforms/hop-geoprocessing/lib</outputDirectory>
      <outputFileNameMapping>${artifact.artifactId}${dashClassifier?}.${artifact.extension}</outputFileNameMapping>
      <scope>runtime</scope>
      <unpack>false</unpack>
      <excludes>
        <exclude>ch.so.agi:hop-transform-geometry-ops</exclude>
        <exclude>ch.so.agi:hop-transform-coverage-ops</exclude>
        <exclude>ch.so.agi:hop-transform-spatial-predicate</exclude>
        <exclude>ch.so.agi:hop-transform-layer-overlay</exclude>
        <exclude>ch.so.agi:hop-transform-layer-aggregate</exclude>
        <exclude>ch.so.agi:hop-geometry-type</exclude>
        <exclude>org.locationtech.jts:jts-core</exclude>
        <exclude>org.geolatte:geolatte-geom</exclude>
        <exclude>org.slf4j:slf4j-api</exclude>
      </excludes>
    </dependencySet>
  </dependencySets>

  <files>
    <file>
      <source>src/assembly/dependencies.xml</source>
      <outputDirectory>plugins/transforms/hop-geoprocessing</outputDirectory>
      <destName>dependencies.xml</destName>
    </file>
  </files>
</assembly>
