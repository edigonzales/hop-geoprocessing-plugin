<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>geometry-reproject-route</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters>
      <parameter>
        <name>E2E_INPUT_DIR</name>
        <default_value />
      </parameter>
      <parameter>
        <name>E2E_OUTPUT_DIR</name>
        <default_value />
      </parameter>
      <parameter>
        <name>TARGET_EPSG</name>
        <default_value>EPSG:3857</default_value>
      </parameter>
    </parameters>
  </info>
  <transform>
    <type>TextFileInput2</type>
    <name>Read WKT</name>
    <file_type>CSV</file_type>
    <compression>None</compression>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar>\</escapechar>
    <header>Y</header>
    <prependFileName>N</prependFileName>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <nr_footerlines>1</nr_footerlines>
    <line_wrapped>N</line_wrapped>
    <nr_wraps>1</nr_wraps>
    <layout_paged>N</layout_paged>
    <nr_lines_per_page>80</nr_lines_per_page>
    <nr_lines_doc_header>0</nr_lines_doc_header>
    <noempty>Y</noempty>
    <include>N</include>
    <include_field />
    <rownum>N</rownum>
    <rownum_field />
    <rownumByFile>N</rownumByFile>
    <format>Unix</format>
    <encoding />
    <limit>0</limit>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <length>Characters</length>
    <filters />
    <error_count_field />
    <error_fields_field />
    <error_text_field />
    <error_line_skipped>N</error_line_skipped>
    <schema_definition />
    <ignore_fields>N</ignore_fields>
    <shortFileFieldName />
    <extensionFieldName />
    <pathFieldName />
    <sizeFieldName />
    <hiddenFieldName />
    <lastModificationTimeFieldName />
    <uriNameFieldName />
    <rootUriNameFieldName />
    <files>
      <file>
        <name>${E2E_INPUT_DIR}/geometry-reproject.csv</name>
        <filemask />
        <exclude_filemask />
        <file_required>Y</file_required>
        <include_subfolders>N</include_subfolders>
      </file>
    </files>
    <accept_filenames>N</accept_filenames>
    <accept_transform_name />
    <passing_through_fields>N</passing_through_fields>
    <accept_field />
    <add_to_result_filenames>N</add_to_result_filenames>
    <error_ignored>N</error_ignored>
    <file_error_field />
    <file_error_message_field />
    <skip_bad_files>N</skip_bad_files>
    <bad_line_files_destination_directory />
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory />
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory />
    <line_number_files_extension>line</line_number_files_extension>
    <fields>
      <field>
        <name>id</name>
        <position>-1</position>
        <length>-1</length>
        <type>Integer</type>
        <ignore>N</ignore>
        <format />
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string />
        <if_null_value />
      </field>
      <field>
        <name>wkt</name>
        <position>-1</position>
        <length>-1</length>
        <type>String</type>
        <ignore>N</ignore>
        <format />
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <repeat>N</repeat>
        <null_string />
        <if_null_value />
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>GEOMETRY_CONVERTER_TRANSFORM</type>
    <name>Decode geometry</name>
    <configuration_version>1</configuration_version>
    <input_format>WKT_EWKT</input_format>
    <input_field>wkt</input_field>
    <input_x_field />
    <input_y_field />
    <input_z_field />
    <input_m_field />
    <output_format>GEOMETRY</output_format>
    <output_field>geometry</output_field>
    <output_x_field />
    <output_y_field />
    <output_z_field />
    <output_m_field />
    <byte_order>BIG_ENDIAN</byte_order>
    <srid_mode>KEEP</srid_mode>
    <srid_value />
    <overwrite_existing_fields>N</overwrite_existing_fields>
    <error_mode>FAIL</error_mode>
    <attributes />
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>300</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>GEOMETRY_REPROJECT_TRANSFORM</type>
    <name>Reproject</name>
    <configuration_version>1</configuration_version>
    <geometry_field>geometry</geometry_field>
    <source_mode>GEOMETRY_SRID</source_mode>
    <source_epsg />
    <target_epsg>${TARGET_EPSG}</target_epsg>
    <output_field>projected</output_field>
    <overwrite_existing_field>N</overwrite_existing_field>
    <error_mode>ROUTE_TO_ERROR</error_mode>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>500</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>GEOMETRY_CONVERTER_TRANSFORM</type>
    <name>Encode result</name>
    <configuration_version>1</configuration_version>
    <input_format>GEOMETRY</input_format>
    <input_field>projected</input_field>
    <input_x_field />
    <input_y_field />
    <input_z_field />
    <input_m_field />
    <output_format>EWKT</output_format>
    <output_field>out</output_field>
    <output_x_field />
    <output_y_field />
    <output_z_field />
    <output_m_field />
    <byte_order>BIG_ENDIAN</byte_order>
    <srid_mode>KEEP</srid_mode>
    <srid_value />
    <overwrite_existing_fields>N</overwrite_existing_fields>
    <error_mode>FAIL</error_mode>
    <attributes />
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Keep normal</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <field>
        <name>id</name>
        <rename>id</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>out</name>
        <rename>out</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>900</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Write normal</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>Y</enclosure_forced>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${E2E_OUTPUT_DIR}/reproject-route</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension>csv</extension>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
    </file>
    <fields />
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Unexpected codec errors</name>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>300</xloc>
      <yloc>400</yloc>
    </GUI>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Keep errors</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <field>
        <name>id</name>
        <rename>id</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>wkt</name>
        <rename>wkt</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>errors</name>
        <rename>errors</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>error_desc</name>
        <rename>error_desc</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>error_fields</name>
        <rename>error_fields</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>error_codes</name>
        <rename>error_codes</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>700</xloc>
      <yloc>300</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Write errors</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>Y</enclosure_forced>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <fileNameInField>N</fileNameInField>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${E2E_OUTPUT_DIR}/reproject-errors</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension>csv</extension>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
    </file>
    <fields />
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>900</xloc>
      <yloc>300</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
  </transform>
  <order>
    <hop>
      <from>Read WKT</from>
      <to>Decode geometry</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Decode geometry</from>
      <to>Reproject</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reproject</from>
      <to>Encode result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Encode result</from>
      <to>Keep normal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep normal</from>
      <to>Write normal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Decode geometry</from>
      <to>Unexpected codec errors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Encode result</from>
      <to>Unexpected codec errors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reproject</from>
      <to>Keep errors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep errors</from>
      <to>Write errors</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform_error_handling>
    <error>
      <source_transform>Decode geometry</source_transform>
      <target_transform>Unexpected codec errors</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>errors</nr_valuename>
      <descriptions_valuename>error_desc</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_codes</codes_valuename>
      <max_errors />
      <max_pct_errors />
      <min_pct_rows />
    </error>
    <error>
      <source_transform>Encode result</source_transform>
      <target_transform>Unexpected codec errors</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>errors</nr_valuename>
      <descriptions_valuename>error_desc</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_codes</codes_valuename>
      <max_errors />
      <max_pct_errors />
      <min_pct_rows />
    </error>
    <error>
      <source_transform>Reproject</source_transform>
      <target_transform>Keep errors</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>errors</nr_valuename>
      <descriptions_valuename>error_desc</descriptions_valuename>
      <fields_valuename>error_fields</fields_valuename>
      <codes_valuename>error_codes</codes_valuename>
      <max_errors />
      <max_pct_errors />
      <min_pct_rows />
    </error>
  </transform_error_handling>
</pipeline>
